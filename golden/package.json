{
  "name": "metacircuit-golden",
  "version": "0.1.0",
  "private": true,
  "description": "Golden (reference) model of the MetaCircuit circuit-editor UI, used as ground truth for RTL verification.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "golden": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rtl": "python3 tools/test_rtl.py",
    "verify:m1": "python3 tools/verify_m1.py",
    "verify:m2": "python3 tools/verify_m2.py",
    "fixtures:solver": "python3 tools/gen_solver_fixtures.py",
    "verify:m3": "python3 tools/verify_m3.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
