{
  "name": "m2_node_colours",
  "description": "M2 node colours under connectivity edits on the boot circuit: split the right rail, rejoin it with a rotated wire, remove ground, re-place it (default rotation leaves it unjoined) and rotate it to rejoin, remove a resistor, and short the two rails through a bridge of wires. Every checkpoint waits for the colours to settle.",
  "steps": [
    "wait 3",
    "checkpoint boot",
    "click_tool delete",
    "click_cell 5 5",
    "wait 3",
    "checkpoint right_rail_split",
    "click_tool wire",
    "click_cell 5 5",
    "wait 3",
    "checkpoint horizontal_wire_unjoined",
    "click_tool rotate",
    "click_cell 5 5",
    "wait 3",
    "checkpoint rotated_wire_rejoins",
    "click_tool delete",
    "click_cell 2 7",
    "wait 3",
    "checkpoint ground_removed",
    "click_tool ground",
    "click_cell 2 7",
    "wait 3",
    "checkpoint ground_restored_unjoined",
    "click_tool rotate",
    "click_cell 2 7",
    "wait 3",
    "checkpoint ground_rotated_joins",
    "click_tool delete",
    "click_cell 3 6",
    "wait 3",
    "checkpoint lower_resistor_removed",
    "click_tool wire",
    "click_cell 3 6",
    "click_cell 4 6",
    "wait 3",
    "checkpoint rails_shorted"
  ]
}
